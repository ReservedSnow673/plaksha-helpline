# Plaksha Helpline — environment variables
# Copy to .env for local development. Production values managed in Render / Vercel.

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- Public URLs ----
APP_BASE_URL=http://localhost:8081
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
WS_BASE_URL=ws://localhost:4000

# ---- Institutional ----
ALLOWED_INSTITUTIONAL_DOMAIN=plaksha.edu.in
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# ---- Database ----
DATABASE_URL=postgres://plaksha:plaksha@localhost:5433/plaksha_helpline
DATABASE_SSL=disable
DATABASE_POOL_MAX=20
DATABASE_POOL_MIN=2

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Crypto (generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ----
JWT_ACCESS_SECRET=change_me_dev_only_0000000000000000000000000000000000000000000000000000000
JWT_REFRESH_SECRET=change_me_dev_only_1111111111111111111111111111111111111111111111111111111
ENCRYPTION_KEY=change_me_dev_only_2222222222222222222222222222222222222222222222222222222
MAGIC_LINK_PEPPER=change_me_dev_only_3333333333333333333333333333333333333333333333333333333
WEBHOOK_SHARED_SECRET=change_me_dev_only_4444444444444444444444444444444444444444444444444444444

# ---- Tokens ----
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
MAGIC_LINK_TTL_MINUTES=15

# ---- Email (Resend) ----
EMAIL_PROVIDER=mock
RESEND_API_KEY=
RESEND_FROM=Plaksha Helpline <helpline@plaksha.edu.in>

# ---- Push notifications ----
EXPO_ACCESS_TOKEN=

# ---- Microsoft Entra (Phase 2) ----
MS_AUTH_ENABLED=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:4000/v1/auth/oidc/callback

# ---- IVR / SMS providers ----
IVR_PROVIDER=mock
IVR_ENABLED=false
RECORDING_ENABLED=false
RECORDING_CONSENT_REQUIRED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_SIGNING_KEY=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_NUMBER=

# ---- Object storage ----
STORAGE_PROVIDER=mock
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=plaksha-helpline-dev

# ---- Observability ----
SENTRY_DSN=
LOGTAIL_TOKEN=

# ---- Operational ----
ESCALATION_TIMER_MULTIPLIER=1.0
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_SOS_PER_MIN=3
RATE_LIMIT_DEFAULT_PER_MIN=60
RETENTION_INCIDENTS_DAYS=365
RETENTION_CHAT_DAYS=90
RETENTION_AUDIT_DAYS=730

# ---- Web (Next.js) ----
# Use /api for local dev (Next.js proxies to API_BASE_URL). Direct :4000 also works.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:4000

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:4000
EXPO_PUBLIC_HELPLINE_NUMBER=+919999999999
EXPO_PUBLIC_SMS_GATEWAY=+919999999999

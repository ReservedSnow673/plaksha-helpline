{
  "name": "@plaksha/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest-e2e.config.js",
    "db:migrate": "sequelize-cli db:migrate --config src/db/sequelize-cli.config.cjs --migrations-path ../../infra/migrations --models-path src/db/models",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config src/db/sequelize-cli.config.cjs --migrations-path ../../infra/migrations",
    "db:seed": "sequelize-cli db:seed:all --config src/db/sequelize-cli.config.cjs --seeders-path ../../infra/seeders",
    "docs:gen": "node dist/scripts/generate-openapi.js",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/sequelize": "^10.0.1",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.3.0",
    "@nestjs/websockets": "^10.4.15",
    "@plaksha/shared-config": "workspace:*",
    "@plaksha/shared-events": "workspace:*",
    "@plaksha/shared-schemas": "workspace:*",
    "@plaksha/shared-types": "workspace:*",
    "@plaksha/shared-utils": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.79.1",
    "expo-server-sdk": "^3.10.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.2.0",
    "pg": "^8.22.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "socket.io": "^4.8.1",
    "twilio": "^5.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@plaksha/eslint-config": "workspace:*",
    "@plaksha/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.12.2",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "dotenv": "^16.4.7",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
